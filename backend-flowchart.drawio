          <mxGeometry x="580" y="490" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;GET&lt;/b&gt; /api/dealers · DealerListRoute.cs&lt;br&gt;reads Users (dealership names for car cards)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="540" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;GET · PUT&lt;/b&gt; /api/dealers/{id} · DealerAccountRoute.cs&lt;br&gt;DealerUpdateRequest · reads + writes Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="590" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;GET&lt;/b&gt; /api/dealers/{id}/sales · DealerAccountRoute.cs&lt;br&gt;reads Purchases" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="640" width="500" height="42" as="geometry" />
        </mxCell>

        <!-- ===== Endpoints: Cars ===== -->
        <mxCell id="areaCars" value="Car endpoints (Routes/Cars, Routes/addCar, Routes/Inventory)" style="swimlane;startSize=30;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="710" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;GET&lt;/b&gt; /api/cars · CarBrowseRoute.cs&lt;br&gt;reads Cars" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="750" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;GET&lt;/b&gt; /api/cars/{id} · CarDetailsRoute.cs&lt;br&gt;reads Cars" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="800" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;POST&lt;/b&gt; /api/cars/add · AddCarRoute.cs&lt;br&gt;CarCreateRequest · reads Users, writes Cars" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
