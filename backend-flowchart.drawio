<mxfile host="app.diagrams.net">
  <diagram id="carswich-backend" name="Backend flow">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Frontend ===== -->
        <mxCell id="front" value="&lt;b&gt;Frontend pages&lt;/b&gt;&lt;br&gt;fetch(&quot;http://localhost:3000/api/…&quot;)&lt;br&gt;&lt;i&gt;see frontend-flowchart.drawio&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="170" height="110" as="geometry" />
        </mxCell>

        <!-- ===== ASP.NET Core pipeline (Program.cs) ===== -->
        <mxCell id="areaPipe" value="ASP.NET Core (Program.cs)" style="swimlane;startSize=30;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#fdf3f2;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="40" width="270" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="startup" value="&lt;b&gt;At startup&lt;/b&gt;&lt;br&gt;• AddDbContext&amp;lt;AppDbContext&amp;gt;(UseSqlite)&lt;br&gt;• AddValidation()&lt;br&gt;• AddCors(&quot;Frontend&quot;)&lt;br&gt;• DbSeeder.ResetAsync(db)&lt;br&gt;• app.Map…Route() for every route file&lt;br&gt;• app.Run() on port 3000" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="90" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="stepCors" value="&lt;b&gt;1. CORS&lt;/b&gt;&lt;br&gt;policy &quot;Frontend&quot; allows&lt;br&gt;localhost:5500 / 127.0.0.1:5500" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="440" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stepRoute" value="&lt;b&gt;2. Routing&lt;/b&gt;&lt;br&gt;URL + HTTP method → the matching&lt;br&gt;app.MapGet / MapPost / MapPut lambda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="560" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stepBind" value="&lt;b&gt;3. Binding + validation&lt;/b&gt;&lt;br&gt;JSON body → DTO record (DTO/…)&lt;br&gt;AppDbContext injected&lt;br&gt;[Required] / [Range] / [EmailAddress] fail → 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="680" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="results" value="&lt;b&gt;Results.*&lt;/b&gt; (Microsoft.AspNetCore.Http)&lt;br&gt;Ok · Created · NotFound ·&lt;br&gt;BadRequest · Conflict&lt;br&gt;→ status code + JSON body" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="880" width="230" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Endpoints: Buyer ===== -->
        <mxCell id="areaBuyer" value="Buyer endpoints (Routes/Buyer, Routes/Purchases, Controllers/Buyer/Buy.cs)" style="swimlane;startSize=30;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f2f7fd;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="40" width="520" height="340" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;POST&lt;/b&gt; /api/buyers/register · BuyerRegRoute.cs&lt;br&gt;BuyerRegisterRequest · reads + writes Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;POST&lt;/b&gt; /api/buyers/login · BuyerAuthRoute.cs&lt;br&gt;LoginRequest · reads Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;GET · PUT&lt;/b&gt; /api/buyers/{id} · BuyerProfileRoute.cs&lt;br&gt;BuyerUpdateRequest · reads + writes Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;POST&lt;/b&gt; /api/buyers/deposit · BuyerDepositRoute.cs&lt;br&gt;BuyerDepositRequest · Buyer.BalanceDeposit() · reads + writes Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="230" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;GET&lt;/b&gt; /api/buyers/{id}/purchases · PurchaseHistoryRoute.cs&lt;br&gt;LINQ join Purchases + Cars + Dealers · reads only" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="280" width="500" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;POST&lt;/b&gt; /api/buy · Buy.cs&lt;br&gt;BuyerPurchaseCar · Car.DeductQuantity() · writes Users, Cars, Purchases" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="500" height="42" as="geometry" />
        </mxCell>

        <!-- ===== Endpoints: Dealer ===== -->
        <mxCell id="areaDealer" value="Dealer endpoints (Routes/Dealer)" style="swimlane;startSize=30;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f3faf2;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="520" height="290" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;POST&lt;/b&gt; /api/dealers/register · DealerRegRoute.cs&lt;br&gt;DealerRegisterRequest · reads + writes Users" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
