        </mxCell>

        <mxCell id="unused" value="&lt;b&gt;Not active:&lt;/b&gt; Controllers/Buyer/BuyerAuthController.cs&lt;br&gt;[ApiController] POST api/buyers/register: never runs, because Program.cs has no AddControllers() / MapControllers()" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="570" y="980" width="520" height="60" as="geometry" />
        </mxCell>

        <!-- ===== Data access + models ===== -->
        <mxCell id="seeder" value="&lt;b&gt;DbSeeder&lt;/b&gt; (DAL/DbSeeder.cs)&lt;br&gt;Runs once at startup: apply migrations, delete all rows, reset IDs, insert test buyers, dealers, cars and purchases" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#666666;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="60" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="&lt;b&gt;AppDbContext&lt;/b&gt; : DbContext (DAL/AppDbContext.cs)&lt;br&gt;DbSets: Users, Buyers, Dealers, Cars, Purchases&lt;br&gt;OnModelCreating: keys, max lengths, unique Email, UserType discriminator, relationships&lt;br&gt;Change tracker → SaveChangesAsync()" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="300" width="330" height="140" as="geometry" />
